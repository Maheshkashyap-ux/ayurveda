flowchart TB

    U["User / Researcher"]
    UI["Web Application<br/>Search & Knowledge Interface"]

    U -->|"Disease / symptom / common term"| UI

    IP["STAGE 1 — INPUT PROCESSING<br/>Text cleaning<br/>Case normalization<br/>Basic tokenization"]

    UI --> IP

    TR["STAGE 2 — TERMINOLOGY RESOLUTION<br/>Synonym lookup<br/>Common → canonical terminology<br/>Ayurvedic terminology mapping<br/>Match type detection"]

    SYN["synonyms.csv<br/>Canonical terms<br/>Common names<br/>Alternative terminology"]

    IP --> TR
    SYN --> TR

    DI["STAGE 3 — CONDITION IDENTIFICATION<br/>Identify canonical disease / condition<br/>Match disease record<br/>Retrieve description"]

    DIS["diseases.csv<br/>Disease ID<br/>Canonical name<br/>Common name<br/>Description"]

    TR --> DI
    DIS --> DI

    KR["STAGE 4 — KNOWLEDGE RETRIEVAL<br/>Retrieve associated formulations<br/>Generate candidate results<br/>Match condition → formulation"]

    FORM["formulations.csv<br/>Formulation ID<br/>Name<br/>Formulation type<br/>Associated condition"]

    DI --> KR
    FORM --> KR

    RANK["STAGE 5 — CANDIDATE RANKING<br/>Terminology match<br/>Condition match<br/>Context match<br/>Evidence availability<br/>Prototype match score"]

    KR --> RANK

    XAI["STAGE 6 — EXPLAINABILITY ENGINE<br/>Why was this result shown?<br/>Match path<br/>Scoring breakdown<br/>Matched terminology<br/>Associated condition"]

    RANK --> XAI

    REF["EVIDENCE / REFERENCES<br/>Source metadata<br/>Classical references<br/>Literature references<br/>Evidence provenance"]

    XAI -.->|"Future evidence layer"| REF

    RES["RESULT ASSEMBLY<br/>Normalized term<br/>Identified condition<br/>Ranked formulations<br/>Match score<br/>Explanation<br/>Evidence status"]

    XAI --> RES
    REF -.-> RES

    OUT["RESULT INTERFACE<br/>Formulation cards<br/>Why this result?<br/>Formulation details<br/>Evidence trail"]

    RES --> OUT
    OUT --> U

    NLP["FUTURE NLP / ML LAYER<br/>Semantic search<br/>Entity recognition<br/>Transliteration handling<br/>Context-aware matching<br/>Learning-based ranking"]

    TR -.->|"Future enhancement"| NLP
    DI -.->|"Future enhancement"| NLP
    RANK -.->|"Future enhancement"| NLP

    LOG["APPLICATION LOGGING<br/>Search queries<br/>Normalization results<br/>Retrieval results<br/>Errors / warnings"]

    UI -.-> LOG
    RES -.-> LOG

flowchart LR

    USER["USER QUERY<br/><br/>Search term<br/>Disease / symptom / common name"]

    SYN["SYNONYM<br/><br/>synonym_id<br/>synonym<br/>canonical_term<br/>match_type"]

    DIS["DISEASE / CONDITION<br/><br/>disease_id<br/>canonical_name<br/>common_name<br/>description"]

    FORM["FORMULATION<br/><br/>formulation_id<br/>name<br/>formulation_type<br/>associated_condition<br/>description"]

    ING["INGREDIENT<br/><br/>ingredient_id<br/>name<br/>scientific_name<br/>plant_part"]

    PROP["AYURVEDIC PROPERTIES<br/><br/>rasa<br/>guna<br/>virya<br/>vipaka"]

    REF["REFERENCE / EVIDENCE<br/><br/>reference_id<br/>title<br/>author<br/>year<br/>source_type<br/>source_location"]

    RESULT["RECOMMENDATION RESULT<br/><br/>normalized_term<br/>matched_condition<br/>formulation<br/>match_score<br/>explanation<br/>evidence_status"]


    USER -->|"Terminology lookup"| SYN

    SYN -->|"Resolves to canonical term"| DIS

    DIS -->|"Associated with"| FORM

    FORM -->|"Contains"| ING

    ING -->|"Has properties"| PROP

    FORM -->|"Supported / traced by"| REF

    FORM -->|"Candidate result"| RESULT

    DIS -->|"Condition context"| RESULT

    SYN -->|"Normalization evidence"| RESULT

    REF -->|"Evidence status"| RESULT


    %% Future extensions

    SYM["SYMPTOM<br/><br/>symptom_id<br/>name<br/>description"]

    FORM_SYM["FORMULATION ↔ SYMPTOM<br/><br/>Association relationship"]

    DIS -->|"May be associated with"| SYM

    SYM -.-> FORM_SYM
    FORM_SYM -.-> FORM


    %% Knowledge graph relationship layer

    KG["KNOWLEDGE GRAPH RELATIONSHIPS<br/><br/>
    has_synonym<br/>
    associated_with<br/>
    contains<br/>
    has_property<br/>
    supported_by<br/>
    has_symptom"]

    SYN -.-> KG
    DIS -.-> KG
    FORM -.-> KG
    ING -.-> KG
    PROP -.-> KG
    REF -.-> KG
